# macOS
.DS_Store

# 本地构建与仿真生成物
build/*
!build/.gitkeep
*.vcd

# Vivado 生成目录和日志（源文件、XDC、脚本不应放入这些目录）
.Xil/
*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.jou
*.log
*.str
*.wdb
*.pb
*.dcp
*.bit

# asm2coe 中间产物；最终需要使用的 COE 可按里程碑单独提交
asm2coe/build/
asm2coe/*.bin
asm2coe/*.asm
asm2coe/mcode.txt
